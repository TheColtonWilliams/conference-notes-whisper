# Only needed once, to download the gated pyannote models. Once every model
# is cached, set HF_HUB_OFFLINE=1 and the token is no longer used.
HF_TOKEN=hf_your_token_here
# 1 = never contact HuggingFace; load models from the local cache only.
# Leave at 0 until the first full run has downloaded every model.
HF_HUB_OFFLINE=0
OLLAMA_HOST=http://localhost:11434
